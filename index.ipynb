   "source": [
    "#Joining movie_basics and movie_id to get avg_rating,votes,genres,movie_id,primary_title,start_year\tand runtime_minutes for visualization\n",
    "query = \"\"\"SELECT mr.averagerating AS avg_rating, mr.numvotes AS votes, mb.genres, mb.movie_id, mb.primary_title, mb.start_year, mb.runtime_minutes FROM movie_ratings AS mr JOIN movie_basics as mb ON mr.movie_id = mb.movie_id WHERE mr.numvotes >= 100 ORDER BY avg_rating ASC ;\"\"\"\n",
    "\n",
    "joined = pd.read_sql(query, conn)\n",
    "joined"
   ]
  },
